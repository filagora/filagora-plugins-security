{
    "name": "filagora/filagora-plugins-security",
    "description": "Security scanning and quarantine for Filagora Plugins: static PHP checks, ClamAV, Semgrep and an LLM review contract.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filagora",
        "plugins",
        "security"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/filagora/filagora-plugins"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-zip": "*",
        "filament/filament": "^5.0",
        "filagora/filagora-core": "^0.2.2",
        "filagora/filagora-plugins": "^0.2"
    },
    "require-dev": {
        "filagora/filagora-entitlements": "^0.2",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\PluginsSecurity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\PluginsSecurity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\PluginsSecurity\\PluginsSecurityServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
